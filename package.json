{
  "name": "simulador-mina-subterranea",
  "version": "0.1.0",
  "description": "Simulador/juego de mina subterranea hiperrealista (NEXA) en Three.js. Entrenamiento operacional, seguridad y recorridos virtuales.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5000",
    "dev:visor": "vite --config vite.visor.config.js --port 5001",
    "build": "vite build",
    "build:visor": "node build-visor.mjs",
    "preview": "vite preview",
    "test:wireframe": "node scripts/verify-wireframe-labor.mjs",
    "test:terminales": "node scripts/verify-terminal-labors.mjs",
    "test:intersecciones": "node scripts/verify-csv-intersections.mjs",
    "generate:mine": "node prueba/generar_elementos_mina.mjs && node prueba/generar_mina_completa.mjs",
    "test:mine": "node scripts/verify-complete-mine.mjs",
    "test:player": "node scripts/verify-player-recovery.mjs",
    "test:nichos": "node scripts/verify-niche-clearance.mjs",
    "test:trafico": "node scripts/verify-traffic-clearance.mjs"
  },
  "keywords": [
    "threejs",
    "mineria",
    "simulador",
    "rapier",
    "vite",
    "webgl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
